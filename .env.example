# .env.example

# --- Backend (FastAPI) ---
# アプリケーションの暗号化やJWT署名に使用するシークレットキー（本番ではAWS Secrets Manager等から注入）
APP_SECRET_KEY=your_super_secret_key_change_this_in_production
# 開発環境用のCORS許可オリジン
ALLOWED_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
POSTGRES_USER=senti_user
POSTGRES_PASSWORD=senti_password
POSTGRES_DB=sentimental_db

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379